                roughness: 0.1,
                emissive_strength: 0.0,
            )),
            rigid_body: Some(Dynamic),
            collider: Some(Sphere(radius: 0.5)),
        ),
        
        // Emissive glowing object
        (
            name: Some("Glowing Orb"),
            transform: Some((
                translation: (-3.0, 2.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),

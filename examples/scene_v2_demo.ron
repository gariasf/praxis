            audio_source: Some((
                path: "assets/audio/fire_crackle.ogg",
                volume: 0.8,
                spatial: true,
                looping: true,
                auto_play: true,
                max_distance: 20.0,
                reference_distance: 1.0,
            )),
        ),
        
        // Metallic object with PBR material
        (
            name: Some("Metal Sphere"),
            transform: Some((
                translation: (3.0, 1.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            )),
            mesh: Some("sphere"),
            material_properties: Some((
                base_color: [0.8, 0.8, 0.9, 1.0],

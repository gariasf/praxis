                roughness: 0.5,
                emissive_strength: 5.0,
            )),
        ),
        
        // Camera
        (
            name: Some("Main Camera"),
            transform: Some((
                translation: (0.0, 5.0, 10.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            )),
            camera: Some((
                camera_type: Perspective,
                fov: Some(1.22173),
                aspect_ratio: Some(1.77778),
                near: 0.1,
                far: 1000.0,
                is_active: true,
                priority: 0,
            )),
        ),
        
        // Directional light (sun)
        (
            name: Some("Sun"),
            directional_light: Some((
                direction: (0.5, -1.0, 0.3),
                color: (1.0, 0.95, 0.8),
                intensity: 1.0,
            )),
        ),
        
        // Point light near fire
        (
            name: Some("Fire Light"),
            transform: Some((
                translation: (5.0, 1.0, 5.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            )),
            point_light: Some((
                color: (1.0, 0.5, 0.2),
                intensity: 5.0,
                range: 10.0,
            )),
        ),
    ],
    editor_data: Some((
        camera: Some((
            position: (0.0, 10.0, 15.0),
            target: (0.0, 0.0, 0.0),

<!-- The sweep on the RTX 2070 SUPER, installed as scripts/sweep.sh says. It
     starts once Task Scheduler sees the PC idle, never waking it, and only
     while its user is logged on, so the bench reaches the GPU. Task
     Scheduler does not stop it when the idle ends: stopping the task ends
     sweep.sh but not a bench it started, which would go on loading the GPU
     with nothing left to publish its results. sweep.sh itself stops before
     its next run once input arrives. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Praxis sweep: benches main when its source lacks a record here, while the PC is idle (scripts/sweep.sh).</Description>
  </RegistrationInfo>
  <Triggers>
    <IdleTrigger>
      <Enabled>true</Enabled>
    </IdleTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <StartWhenAvailable>false</StartWhenAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>4</Priority>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>@BASH@</Command>
      <Arguments>-l "@SWEEP@/scripts/sweep.sh"</Arguments>
    </Exec>
  </Actions>
</Task>

+
+/// Probe: CLOCK_UPTIME_RAW in seconds, Metal's host time base.
+fn probe_uptime_seconds() -> f64 {
+    unsafe extern "C" {
+        fn clock_gettime_nsec_np(clock: u32) -> u64;
+    }
+    // CLOCK_UPTIME_RAW is 8 in <time.h>.
+    unsafe { clock_gettime_nsec_np(8) as f64 * 1e-9 }
 }

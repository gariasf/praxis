#version 450

layout(local_size_x = 256) in;

// Match GpuParticle struct in Rust
struct GpuParticle {
    vec3 position;
    float _padding1;
    vec3 velocity;
    float _padding2;
    vec4 color;
    float size;
    float rotation;
    float lifetime;
    float camera_distance;
};

layout(set = 0, binding = 0, std430) buffer ParticleBuffer {
    GpuParticle particles[];
};

layout(push_constant) uniform PushConstants {
    uint stage;
    uint substage;
    uint num_particles;
} pc;

void main() {
    uint id = gl_GlobalInvocationID.x;
    
    if (id >= pc.num_particles) {
        return;
    }
    
    uint distance = uint(1 << pc.stage);
    uint offset = uint(1 << pc.substage);
    
    uint partner_id = id ^ offset;
    
    if (partner_id < pc.num_particles && partner_id > id) {
        bool ascending = ((id & distance) == 0);
        
        float dist_a = particles[id].camera_distance;
        float dist_b = particles[partner_id].camera_distance;
        
        // Sort back-to-front for alpha blending (higher distance first)
        bool should_swap = (ascending && dist_a < dist_b) || (!ascending && dist_a > dist_b);
        
        if (should_swap) {
            GpuParticle temp = particles[id];
            particles[id] = particles[partner_id];
            particles[partner_id] = temp;
        }
    }
}

#version 450

// GPU-accelerated particle update compute shader
// Updates particle positions, velocities, and properties on the GPU

layout(local_size_x = 256) in;

// Match GpuParticle struct in Rust
struct GpuParticle {
    vec3 position;
    float _padding1;
    vec3 velocity;
    float _padding2;
    vec4 color;
    float size;
    float rotation;
    float lifetime;
    float camera_distance;
};

layout(set = 0, binding = 0, std430) buffer ParticleBuffer {
    GpuParticle particles[];
};

layout(set = 0, binding = 1, std140) uniform UpdateUniforms {
    float delta_time;
    vec3 gravity;
    vec3 wind_direction;
    float wind_strength;
    float wind_turbulence;
    float drag_coefficient;
    vec3 camera_position;
    uint particle_count;
} uniforms;

// Simple hash function for randomness
float hash(uint seed) {
    seed = (seed ^ 61u) ^ (seed >> 16u);
    seed *= 9u;
    seed = seed ^ (seed >> 4u);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15u);
    return float(seed) / 4294967296.0;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    
    if (id >= uniforms.particle_count) {
        return;
    }
    
    GpuParticle particle = particles[id];
    
    // Skip dead particles
    if (particle.lifetime <= 0.0) {
        return;
    }
    
    // Update lifetime
    particle.lifetime -= uniforms.delta_time;
    
    if (particle.lifetime <= 0.0) {
        particle.lifetime = 0.0;
        particles[id] = particle;
        return;
    }
    
    // Apply forces
    // Gravity
    particle.velocity += uniforms.gravity * uniforms.delta_time;
    
    // Wind with turbulence
    vec3 wind = uniforms.wind_direction * uniforms.wind_strength;
    if (uniforms.wind_turbulence > 0.0) {
        float turb_x = (hash(id * 3u + 0u) - 0.5) * uniforms.wind_turbulence;
        float turb_y = (hash(id * 3u + 1u) - 0.5) * uniforms.wind_turbulence;
        float turb_z = (hash(id * 3u + 2u) - 0.5) * uniforms.wind_turbulence;
        wind += vec3(turb_x, turb_y, turb_z);
    }
    particle.velocity += wind * uniforms.delta_time;
    
    // Drag
    particle.velocity *= (1.0 - uniforms.drag_coefficient * uniforms.delta_time);
    
    // Update position
    particle.position += particle.velocity * uniforms.delta_time;
    
    // Update rotation
    particle.rotation += 1.0 * uniforms.delta_time; // Simple rotation for now
    
    // Update camera distance for sorting
    vec3 to_camera = uniforms.camera_position - particle.position;
    particle.camera_distance = length(to_camera);
    
    // Write back
    particles[id] = particle;
}

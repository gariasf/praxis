#version 450

// GPU-driven culling compute shader
// Performs frustum culling, back-face culling, small object culling,
// distance culling, and occlusion culling on the GPU to generate indirect draw buffers

// Work group size - process 64 draw commands per work group
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input: Draw command data
struct DrawCommand {
    mat4 model;              // Model matrix (64 bytes)
    vec4 bounding_sphere;    // xyz = center, w = radius (16 bytes)
    vec4 average_normal;     // xyz = normal direction, w = backface threshold (16 bytes)
    uint mesh_id;            // Index into mesh data (4 bytes)
    uint material_id;        // Index into material data (4 bytes)
    float min_screen_size;   // Minimum screen-space size in pixels (4 bytes)
    float max_render_distance; // Maximum render distance (4 bytes)
    // Total: 112 bytes
};

// Output: Indirect draw command (VkDrawIndexedIndirectCommand)
struct IndirectDrawCommand {
    uint index_count;        // Number of indices to draw
    uint instance_count;     // Number of instances (1 for non-instanced)
    uint first_index;        // First index in index buffer
    int vertex_offset;       // Offset added to vertex index
    uint first_instance;     // First instance ID
    // Total: 20 bytes
};

// Culling uniforms
layout(set = 0, binding = 0, std140) uniform CullingUniforms {
    mat4 view_proj;          // View-projection matrix for frustum culling
    vec4 frustum_planes[6];  // Frustum planes in world space (xyz = normal, w = distance)
    vec3 camera_position;    // Camera position in world space
    float _padding1;
    vec3 camera_direction;   // Camera forward direction (for back-face culling)
    float _padding2;
    vec2 screen_dimensions;  // Screen dimensions (width, height)
    vec2 _padding3;
    uint enable_frustum_culling;
    uint enable_occlusion_culling;
    uint enable_backface_culling;
    uint enable_small_object_culling;
    uint enable_distance_culling;
    uint draw_command_count; // Number of draw commands to process
    uvec2 _padding4;
} culling;

// Input buffer: Draw commands
layout(set = 0, binding = 1, std430) readonly buffer DrawCommands {
    DrawCommand commands[];
} draw_commands;

// Input buffer: Mesh data (index counts, vertex offsets)
struct MeshData {
    uint index_count;
    uint first_index;
    int vertex_offset;
    uint _padding;
};

layout(set = 0, binding = 2, std430) readonly buffer MeshDataBuffer {
    MeshData meshes[];
} mesh_data;

// Output buffer: Indirect draw commands
layout(set = 0, binding = 3, std430) writeonly buffer IndirectDrawBuffer {
    IndirectDrawCommand draws[];
} indirect_draws;

// Output buffer: Visible draw command indices
layout(set = 0, binding = 4, std430) writeonly buffer VisibleIndices {
    uint indices[];
} visible_indices;

// Output buffer: Draw count (atomic counter)
layout(set = 0, binding = 5, std430) buffer DrawCount {
    uint count;
} draw_count;

// Hi-Z depth pyramid sampler for occlusion culling
layout(set = 0, binding = 6) uniform sampler2D hiz_pyramid;

// Frustum culling: Test bounding sphere against view frustum planes
bool is_sphere_in_frustum(vec3 center, float radius) {
    // Test sphere against all 6 frustum planes
    for (int i = 0; i < 6; i++) {
        vec4 plane = culling.frustum_planes[i];
        float distance = dot(plane.xyz, center) + plane.w;
        
        // If sphere is completely outside any plane, it's not visible
        if (distance < -radius) {
            return false;
        }
    }
    return true;
}

// Back-face culling: Test if object is facing away from camera
bool is_facing_camera(vec3 world_normal, vec3 object_center, float threshold) {
    // Direction from object to camera
    vec3 to_camera = normalize(culling.camera_position - object_center);
    
    // Alternatively, use camera forward direction for more consistent culling
    // For objects like terrain patches, use the object-to-camera direction
    // For objects with known facing direction, use the camera direction
    float dot_product = dot(world_normal, to_camera);
    
    // Object is facing camera if dot product is positive (within threshold)
    // Threshold allows some tolerance (typically -0.1 to 0.1)
    return dot_product >= threshold;
}

// Distance culling: Test if object is within render distance
bool is_within_distance(vec3 object_center, float max_distance) {
    if (max_distance < 0.0) {
        // Negative max_distance means no distance culling for this object
        return true;
    }
    
    float distance = length(culling.camera_position - object_center);
    return distance <= max_distance;
}

// Small object culling: Test if object's screen-space projection is large enough
bool is_large_enough(vec3 world_center, float world_radius, float min_screen_size) {
    if (min_screen_size <= 0.0) {
        // Zero or negative min_screen_size means no small object culling
        return true;
    }
    
    // Project sphere center to clip space
    vec4 clip_center = culling.view_proj * vec4(world_center, 1.0);
    
    // Check if behind camera
    if (clip_center.w <= 0.0) {
        return false;
    }
    
    // Calculate screen-space radius
    // The sphere's radius in screen space depends on its distance from camera
    float view_space_z = clip_center.w;
    
    // Project the radius using perspective divide
    // Approximate screen-space radius in NDC units
    float ndc_radius = world_radius / view_space_z;
    
    // Convert to pixel size
    // NDC is [-1, 1], so 2 units cover the entire screen
    float screen_radius_x = ndc_radius * culling.screen_dimensions.x * 0.5;
    float screen_radius_y = ndc_radius * culling.screen_dimensions.y * 0.5;
    float screen_radius = max(screen_radius_x, screen_radius_y);
    
    // Object is large enough if its screen-space radius exceeds the minimum
    // We use diameter for the comparison (2 * radius)
    float screen_diameter = screen_radius * 2.0;
    return screen_diameter >= min_screen_size;
}

// Occlusion culling: Test bounding sphere against Hi-Z depth pyramid
// Returns true if the object is visible (not occluded)
bool is_visible_hiz(vec3 world_center, float world_radius) {
    // Project bounding sphere center to clip space
    vec4 clip_center = culling.view_proj * vec4(world_center, 1.0);
    
    // Early rejection if behind camera
    if (clip_center.w <= 0.0) {
        return false;
    }
    
    // Convert to NDC
    vec3 ndc = clip_center.xyz / clip_center.w;
    
    // Early rejection if outside NDC bounds [-1, 1]
    if (abs(ndc.x) > 1.0 || abs(ndc.y) > 1.0 || abs(ndc.z) > 1.0) {
        return false;
    }
    
    // Convert NDC to screen space UV [0, 1]
    vec2 screen_uv = ndc.xy * 0.5 + 0.5;
    
    // Project bounding sphere radius to screen space
    // We test the point on the sphere closest to the camera
    vec3 closest_point = world_center - normalize(culling.camera_position - world_center) * world_radius;
    vec4 clip_closest = culling.view_proj * vec4(closest_point, 1.0);
    
    // Calculate screen-space bounding box of the sphere
    // For simplicity, we project the sphere radius in view space
    float view_space_z = clip_center.w;
    float screen_radius = world_radius / view_space_z;
    
    // Calculate screen-space AABB in UV coordinates
    vec2 aabb_min = screen_uv - vec2(screen_radius);
    vec2 aabb_max = screen_uv + vec2(screen_radius);
    
    // Clamp to [0, 1] range
    aabb_min = clamp(aabb_min, vec2(0.0), vec2(1.0));
    aabb_max = clamp(aabb_max, vec2(0.0), vec2(1.0));
    
    // Calculate the screen-space size of the bounding box
    vec2 aabb_size = aabb_max - aabb_min;
    
    // Get Hi-Z pyramid dimensions
    vec2 hiz_size = vec2(textureSize(hiz_pyramid, 0));
    
    // Calculate optimal mip level based on screen-space size
    // We want to sample a mip level where the bounding box covers roughly 2x2 pixels
    vec2 pixel_size = aabb_size * hiz_size;
    float max_dimension = max(pixel_size.x, pixel_size.y);
    float mip_level = max(0.0, log2(max_dimension) - 1.0);
    
    // Clamp mip level to available range
    float max_mip = float(textureQueryLevels(hiz_pyramid) - 1);
    mip_level = clamp(mip_level, 0.0, max_mip);
    
    // Sample Hi-Z pyramid at the calculated mip level
    // Sample at the four corners and center of the bounding box for robustness
    float hiz_depth0 = textureLod(hiz_pyramid, aabb_min, mip_level).r;
    float hiz_depth1 = textureLod(hiz_pyramid, aabb_max, mip_level).r;
    float hiz_depth2 = textureLod(hiz_pyramid, vec2(aabb_min.x, aabb_max.y), mip_level).r;
    float hiz_depth3 = textureLod(hiz_pyramid, vec2(aabb_max.x, aabb_min.y), mip_level).r;
    float hiz_depth_center = textureLod(hiz_pyramid, screen_uv, mip_level).r;
    
    // Take the maximum depth (farthest from camera) for conservative testing
    float max_hiz_depth = max(max(max(hiz_depth0, hiz_depth1), max(hiz_depth2, hiz_depth3)), hiz_depth_center);
    
    // Object depth in NDC space (closest point of sphere to camera)
    float object_depth = clip_closest.z / clip_closest.w;
    
    // Convert NDC depth to [0, 1] range (same as Hi-Z pyramid)
    object_depth = object_depth * 0.5 + 0.5;
    
    // Object is visible if its closest point is in front of the Hi-Z depth
    // Add a small bias to avoid precision issues
    const float DEPTH_BIAS = 0.001;
    return object_depth <= (max_hiz_depth + DEPTH_BIAS);
}

void main() {
    uint draw_index = gl_GlobalInvocationID.x;
    
    // Early out if beyond command count
    if (draw_index >= culling.draw_command_count) {
        return;
    }
    
    // Load draw command
    DrawCommand cmd = draw_commands.commands[draw_index];
    
    // Transform bounding sphere center to world space
    vec4 world_center = cmd.model * vec4(cmd.bounding_sphere.xyz, 1.0);
    
    // Calculate world-space radius (conservative approach for non-uniform scales)
    // Take the maximum scale factor from the model matrix
    float scale_x = length(cmd.model[0].xyz);
    float scale_y = length(cmd.model[1].xyz);
    float scale_z = length(cmd.model[2].xyz);
    float max_scale = max(max(scale_x, scale_y), scale_z);
    float world_radius = cmd.bounding_sphere.w * max_scale;
    
    bool is_visible = true;
    
    // Frustum culling (first pass - broadest cull)
    if (is_visible && culling.enable_frustum_culling != 0) {
        if (!is_sphere_in_frustum(world_center.xyz, world_radius)) {
            is_visible = false;
        }
    }
    
    // Distance culling (second pass - cull objects too far away)
    if (is_visible && culling.enable_distance_culling != 0) {
        if (!is_within_distance(world_center.xyz, cmd.max_render_distance)) {
            is_visible = false;
        }
    }
    
    // Back-face culling (third pass - cull objects facing away)
    if (is_visible && culling.enable_backface_culling != 0) {
        // Transform average normal to world space
        vec3 world_normal = normalize(mat3(cmd.model) * cmd.average_normal.xyz);
        float threshold = cmd.average_normal.w;
        
        if (!is_facing_camera(world_normal, world_center.xyz, threshold)) {
            is_visible = false;
        }
    }
    
    // Small object culling (fourth pass - cull objects too small on screen)
    if (is_visible && culling.enable_small_object_culling != 0) {
        if (!is_large_enough(world_center.xyz, world_radius, cmd.min_screen_size)) {
            is_visible = false;
        }
    }
    
    // Occlusion culling (final pass - most expensive, only test if passed all other tests)
    if (is_visible && culling.enable_occlusion_culling != 0) {
        if (!is_visible_hiz(world_center.xyz, world_radius)) {
            is_visible = false;
        }
    }
    
    // If visible, add to output buffer
    if (is_visible) {
        // Atomically increment draw count and get index
        uint output_index = atomicAdd(draw_count.count, 1);
        
        // Bounds check to prevent buffer overflow
        if (output_index < culling.draw_command_count) {
            // Get mesh data (bounds already checked by Vulkan robustness)
            MeshData mesh = mesh_data.meshes[cmd.mesh_id];
            
            // Write indirect draw command
            IndirectDrawCommand draw_cmd;
            draw_cmd.index_count = mesh.index_count;
            draw_cmd.instance_count = 1;
            draw_cmd.first_index = mesh.first_index;
            draw_cmd.vertex_offset = mesh.vertex_offset;
            draw_cmd.first_instance = draw_index;
            indirect_draws.draws[output_index] = draw_cmd;
            
            // Write visible index for material/transform lookup
            visible_indices.indices[output_index] = draw_index;
        }
    }
}

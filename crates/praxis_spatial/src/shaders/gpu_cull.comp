#version 450

layout(local_size_x = 256) in;

struct ObjectData {
    vec4 aabb_min;
    vec4 aabb_max;
    vec4 position;
    uint mesh_id;
    uint lod_group_id;
    float bounding_radius;
    uint padding;
};

struct LodLevel {
    uint mesh_id;
    float min_distance_squared;
    float max_distance_squared;
    uint padding;
};

struct LodGroup {
    LodLevel levels[8];
    uint level_count;
    float lod_bias;
    uint padding1;
    uint padding2;
};

struct CullingResult {
    uint object_index;
    uint mesh_id;
    uint is_visible;
    uint lod_level;
};

layout(set = 0, binding = 0) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(set = 0, binding = 1) readonly buffer LodGroupBuffer {
    LodGroup lod_groups[];
};

layout(set = 0, binding = 2) writeonly buffer ResultBuffer {
    CullingResult results[];
};

layout(set = 0, binding = 3) buffer CounterBuffer {
    uint visible_count;
    uint frustum_culled_count;
    uint distance_culled_count;
    uint total_processed;
};

layout(push_constant) uniform PushConstants {
    mat4 view_proj;
    vec4 camera_position;
    vec4 frustum_planes[6];
    float max_distance;
    uint object_count;
    uint enable_lod;
    uint enable_distance_culling;
} pc;

bool test_aabb_plane(vec3 aabb_min, vec3 aabb_max, vec4 plane) {
    vec3 positive_vertex = vec3(
        plane.x >= 0.0 ? aabb_max.x : aabb_min.x,
        plane.y >= 0.0 ? aabb_max.y : aabb_min.y,
        plane.z >= 0.0 ? aabb_max.z : aabb_min.z
    );
    
    float distance = dot(plane.xyz, positive_vertex) + plane.w;
    return distance >= 0.0;
}

bool frustum_cull_aabb(vec3 aabb_min, vec3 aabb_max) {
    for (int i = 0; i < 6; i++) {
        if (!test_aabb_plane(aabb_min, aabb_max, pc.frustum_planes[i])) {
            return true;
        }
    }
    return false;
}

uint select_lod_level(uint lod_group_id, float distance_squared) {
    if (pc.enable_lod == 0 || lod_group_id >= 1024) {
        return 0;
    }
    
    LodGroup group = lod_groups[lod_group_id];
    
    float bias_scale = 1.0;
    if (group.lod_bias > 0.0) {
        bias_scale = 1.0 - group.lod_bias * 0.5;
    } else if (group.lod_bias < 0.0) {
        bias_scale = 1.0 + (-group.lod_bias) * 0.5;
    }
    
    float adjusted_distance_squared = distance_squared * bias_scale * bias_scale;
    
    for (uint i = 0; i < group.level_count && i < 8; i++) {
        LodLevel level = group.levels[i];
        if (adjusted_distance_squared >= level.min_distance_squared &&
            adjusted_distance_squared < level.max_distance_squared) {
            return i;
        }
    }
    
    return group.level_count > 0 ? group.level_count - 1 : 0;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    
    if (id >= pc.object_count) {
        return;
    }
    
    ObjectData obj = objects[id];
    
    vec3 aabb_min = obj.aabb_min.xyz;
    vec3 aabb_max = obj.aabb_max.xyz;
    vec3 position = obj.position.xyz;
    
    bool is_visible = true;
    uint cull_reason = 0;
    
    vec3 to_camera = pc.camera_position.xyz - position;
    float distance_squared = dot(to_camera, to_camera);
    
    if (pc.enable_distance_culling != 0) {
        float max_dist_sq = pc.max_distance * pc.max_distance;
        if (distance_squared > max_dist_sq) {
            is_visible = false;
            cull_reason = 1;
            atomicAdd(distance_culled_count, 1);
        }
    }
    
    if (is_visible) {
        if (frustum_cull_aabb(aabb_min, aabb_max)) {
            is_visible = false;
            cull_reason = 2;
            atomicAdd(frustum_culled_count, 1);
        }
    }
    
    uint selected_mesh_id = obj.mesh_id;
    uint lod_level = 0;
    
    if (is_visible && pc.enable_lod != 0 && obj.lod_group_id < 1024) {
        lod_level = select_lod_level(obj.lod_group_id, distance_squared);
        LodGroup group = lod_groups[obj.lod_group_id];
        if (lod_level < group.level_count) {
            selected_mesh_id = group.levels[lod_level].mesh_id;
        }
    }
    
    if (is_visible) {
        uint result_index = atomicAdd(visible_count, 1);
        results[result_index].object_index = id;
        results[result_index].mesh_id = selected_mesh_id;
        results[result_index].is_visible = 1;
        results[result_index].lod_level = lod_level;
    }
    
    atomicAdd(total_processed, 1);
}
